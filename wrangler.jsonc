{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apex-shield-roofing",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
