# ── Whop identifiers (public, safe to commit in .env.production) ─────────────
# Business account, prefixed biz_. Used for the pixel scope and API calls.
VITE_WHOP_ACCOUNT_ID=biz_REPLACE_WITH_YOUR_ACCOUNT_ID

# production | sandbox
VITE_WHOP_ENVIRONMENT=production

# Create these three plans in Whop Dashboard → Products, then paste the plan IDs.
VITE_WHOP_PLAN_INSPECTION=plan_REPLACE_INSPECTION
VITE_WHOP_PLAN_DEPOSIT=plan_REPLACE_DEPOSIT
VITE_WHOP_PLAN_FLAT_RATE=plan_REPLACE_FLAT_RATE

# ── Optional server routes (never put a Whop API key in this file) ───────────
# Receives the estimate form payload and forwards it to the Whop Events API.
# VITE_LEAD_ENDPOINT=/api/lead

# Receives the final balance statement and creates the invoice through Whop.
# VITE_INVOICE_ENDPOINT=/api/invoice
